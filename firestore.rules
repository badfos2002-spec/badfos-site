rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Admin check ───────────────────────────────────────────────────
    // Replace with the value of NEXT_PUBLIC_ADMIN_EMAIL in your .env.local
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'badfos2002@gmail.com';
    }

    // ── Orders ────────────────────────────────────────────────────────────────
    // Anyone can create (checkout flow); only admin can read/update/delete
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Leads ─────────────────────────────────────────────────────────────────
    // Anyone can submit a lead; only admin can manage
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Reviews ───────────────────────────────────────────────────────────────
    // Approved reviews are public; anyone can submit; admin manages
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved';
      // Public submissions must be pending — only an admin can approve, so an
      // anonymous client can never publish a self-approved review.
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ── Coupons ───────────────────────────────────────────────────────────────
    // No client read — validation runs server-side via /api/coupon/validate
    // (admin SDK), which never leaks the code list or a coupon's restrictedPhone.
    // Only admin writes (recovery/share coupons are created with the admin SDK).
    match /coupons/{couponId} {
      allow read: if false;
      allow write: if isAdmin();
    }

    // ── Packages ──────────────────────────────────────────────────────────────
    // Public read for the packages page; admin writes
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Package Orders ────────────────────────────────────────────────────────
    // Anyone can place a package order; admin manages
    match /packageOrders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Site Images ───────────────────────────────────────────────────────────
    // Public read (homepage, product pages); admin writes
    match /siteImages/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Pricing ───────────────────────────────────────────────────────────────
    // Public read; admin writes
    match /pricing/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Discounts ─────────────────────────────────────────────────────────────
    // Public read (checkout needs active discounts); admin writes
    match /discounts/{discountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Inventory ─────────────────────────────────────────────────────────────
    // Admin only
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    // Public read (deals page); admin writes
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Admin Settings ────────────────────────────────────────────────────────
    // Private business configuration (system subscription costs + the owner's
    // digest recipient addresses). Deliberately NOT under /settings, which is
    // world-readable. Admin only, both directions.
    match /adminSettings/{docId} {
      allow read, write: if isAdmin();
    }

    // ── Counters ──────────────────────────────────────────────────────────────
    // Admin only. Order numbering runs server-side via /api/order/next-number
    // (admin SDK, bypasses rules); admin quote numbering runs client-side and
    // stays allowed via isAdmin(). Anonymous clients can no longer read or
    // overwrite the counters.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // ── Shared Designs ────────────────────────────────────────────────────────
    // Anyone can create and read shared designs (public share links)
    match /shared_designs/{designId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ── Shared Carts (multiple designs) ─────────────────────────────────────
    match /shared_carts/{cartId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ── Quotes (הצעות מחיר) ───────────────────────────────────────────────────
    // Admin only — private business documents
    match /quotes/{quoteId} {
      allow read, write: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
