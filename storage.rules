rules_version = '2';

// Firebase Storage security rules for badfos-28b67.
//
// Threat closed: prior (console-managed) rules left `designs/` world-listable AND
// world-readable, so anyone could enumerate + download every customer's uploaded
// artwork by walking order IDs. These rules kill public listing and public reads.
//
// Read posture for designs/ = FILE-LEVEL READ ALLOWED, NO LISTING.
// Rationale: the checkout upload flow calls getDownloadURL() immediately after
// uploading (lib/storage.ts uploadBase64Image), and getDownloadURL REQUIRES read
// permission on the object — so read:false broke customer uploads
// (storage/unauthorized). We therefore allow read at the FILE level only.
// This still closes the real exposure: listing/enumeration of designs/ requires
// read on the PREFIX path, which no rule grants (the match is 3 segments deep),
// so listAll on designs/ or designs/{orderId}/ stays DENIED. An attacker cannot
// enumerate customers' artwork; only someone who already knows an exact,
// unguessable path (orderId + timestamped random filename) could fetch that one
// file — the standard, acceptable posture for token-served assets.

service firebase.storage {
  match /b/{bucket}/o {

    // Customer design uploads (anonymous checkout writes here).
    match /designs/{orderId}/{fileName} {
      // File-level read only (needed by getDownloadURL after upload). Listing the
      // designs/ prefix stays denied — no rule grants read on the parent path — so
      // customers' artwork cannot be enumerated.
      allow read: if true;

      // Anonymous checkout may upload images, constrained to <30MB and image/* only.
      //
      // 30MB, raised from 15MB: 15MB rejected ordinary customer artwork (a 20MB
      // phone photo or exported PNG), and Firebase surfaces a rules denial as
      // `storage/unauthorized` — so the customer saw a generic failure and left.
      // The trade-off is accepted knowingly: this path is ANONYMOUSLY writable,
      // so doubling the cap doubles the bytes one abusive request can park in
      // the bucket. What bounds the damage is unchanged — image/* only, no
      // listing (so nothing here is reachable as a public file host), and
      // clients never exceed the cap in the first place because
      // lib/print-image.ts reduces oversized artwork before upload. Anything
      // above 30MB is still refused here, and now with a Hebrew explanation
      // instead of a silent 403.
      allow create: if request.resource.size < 30 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      // Only authenticated admins (Firebase Auth) may delete (admin order deletion).
      allow delete: if request.auth != null;
    }

    // Admin-managed public marketing assets (mockups + site images).
    // Uploaded via client SDK from the admin panel (Firebase-authenticated), and
    // displayed publicly on the site. Public read at the FILE level only (no prefix
    // read => no enumeration); writes require authentication.
    match /mockups/{category}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /site-images/{category}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Backups and everything else: no client access. Server uses the Admin SDK,
    // which bypasses these rules.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
