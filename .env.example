# Firebase Client (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (Server-side - Keep Secret!)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Resend (Email Service)
RESEND_API_KEY=

# OpenAI (AI Design Generation)
OPENAI_API_KEY=

# Admin Authentication
NEXT_PUBLIC_ADMIN_EMAIL=your-admin@email.com

# Analytics
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=5507794277

# Site URL (for production)
NEXT_PUBLIC_SITE_URL=https://badfos.co.il

# Make.com webhook URL for payment creation (required)
MAKE_WEBHOOK_URL=

# Webhook secret for payment notification verification (set in Grow dashboard)
WEBHOOK_SECRET=

# Grow webhook key (from Grow dashboard — prevents webhook forgery)
GROW_WEBHOOK_KEY=

# ── System status screen (/admin/costs) — ALL OPTIONAL ────────────────────
# Every one of these is optional. With none of them set, the screen still
# renders every system; those cards just read "ידני"/"נספר" instead of "חי".
# Server-side only — never expose any of these as NEXT_PUBLIC_.

# Vercel: monthly billed cost. Token needs access to the team that owns the
# project (Account Settings → Tokens). VERCEL_TEAM_ID only if the project
# lives under a team rather than a personal account.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# Make: operations + data transfer used in the last 30 days.
# Zone must match your Make dashboard URL (eu1 / eu2 / us1 / us2); eu2 default.
# MAKE_ORG_ID only if the token can see more than one organization.
MAKE_API_TOKEN=
MAKE_API_ZONE=
MAKE_ORG_ID=

# OpenAI: actual spend. Must be an ADMIN key (sk-admin-...), NOT the regular
# project key above — a project key returns 401 on the organization endpoints.
OPENAI_ADMIN_KEY=

# RESEND_API_KEY and REPLICATE_API_TOKEN (already set above for sending mail
# and upscaling) additionally light up their status cards — nothing to add.
